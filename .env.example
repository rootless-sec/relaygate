# RelayGate Server Configuration
RELAYGATE_ADDR=:8080
RELAYGATE_DB_PATH=./data/relaygate.db
RELAYGATE_WORKERS=10

# Real Gmail SMTP Configuration for OTP Delivery
# Ganti SMTP_PASS dengan Google App Password (Sandi Aplikasi 16 karakter) dari:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mafifrizi@gmail.com
SMTP_PASS=ganti-dengan-16-karakter-app-password
SMTP_FROM=RelayGate <mafifrizi@gmail.com>
